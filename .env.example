POSTGRES_USER=aged_care
POSTGRES_PASSWORD=aged_care
POSTGRES_DB=aged_care_compliance
DATABASE_URL=postgresql://aged_care:aged_care@db:5432/aged_care_compliance
VITE_API_URL=http://localhost:8002
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=changeme
LLM_MODEL=meta/llama-3.1-70b-instruct
JWT_SECRET=changeme-dev-secret

# Extraction throughput. Documents are extracted with many concurrent LLM calls,
# paced to stay under the provider's tokens-per-minute limit. Firing faster than the
# limit is counter-productive: the retry backoff measured LOWER throughput and lost
# sections. Raise EXTRACTION_RPS only if the account's rate limit is higher.
# Defaults are tuned for OpenAI gpt-4o-mini at 200k TPM.
EXTRACTION_RPS=1.3
EXTRACTION_CONCURRENCY=16

# How long a login lasts, in minutes. The frontend keeps the session alive for
# exactly this long and then returns to the login screen.
JWT_EXPIRE_MINUTES=480
